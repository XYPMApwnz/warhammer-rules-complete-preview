+    script = ("import fs from 'node:fs';"
+        "import {parseProducerJSON} from './books/shared/source-refs-v2/producer-io.mjs';"
+        "process.stdout.write(JSON.stringify(parseProducerJSON(fs.readFileSync(process.argv[1],'utf8'))));")
